# mcp-server-mysql 的运行配置模板。/ Config template for mcp-server-mysql.
#
# 用法 / Usage:
#   cp .env.example .env
#   # 生成密钥并填入 REMOTE_SECRET_KEY / generate a key and fill REMOTE_SECRET_KEY
#   openssl rand -hex 24

# ---- MySQL 连接 / MySQL connection ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=travel_demo

# ---- 写操作开关：demo 一律保持关闭 / Write switches: keep all off for the demo ----
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false

# ---- 安全护栏 / Safety guards ----
MYSQL_RATE_LIMIT=100
MYSQL_MAX_QUERY_COMPLEXITY=1000
MYSQL_QUERY_TIMEOUT=30000

# ---- 日志：开着才能看到模型实际发了什么 SQL ----
# ---- Logging: keep it on to see the SQL the model actually issues ----
ENABLE_LOGGING=true
MYSQL_LOG_LEVEL=info

# ---- Remote 模式：走 Streamable HTTP，端点 POST /mcp ----
# ---- Remote mode: Streamable HTTP, endpoint POST /mcp ----
IS_REMOTE_MCP=true
PORT=3000
REMOTE_SECRET_KEY=
